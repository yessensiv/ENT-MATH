# Server secrets only. Set in the Sites hosting environment; never use NEXT_PUBLIC_.
# DB is a provisioned Cloudflare D1 binding, selected in .openai/hosting.json.
# Apply generated Drizzle migrations before starting or publishing.
ADMIN_EMAILS=teacher@example.kz
TUTOR_API_KEY=
TUTOR_BASE_URL=https://api.openai.com/v1
TUTOR_MODEL=gpt-4.1-mini
TUTOR_VISION_MODEL=gpt-4.1-mini
TUTOR_DAILY_LIMIT=30
# Conservative per-user token reservations. Also set spending limits at the provider.
TUTOR_DAILY_TOKEN_LIMIT=120000
# Local testing identity is supplied ONLY by the existing Sites dispatch/auth layer.
# Do not add a fake authentication header or create a production demo account.

# Read docs/TZ-OPERATIONS.md before rollback. Keep events normally.
EVENT_STORAGE_MODE=events

# Editorial roles: server configuration only; omitted accounts are students.
# Example (replace with actual approved accounts):
# EDITOR_ROLES={"author@example.com":["author"],"reviewer@example.com":["math","methodology"],"language@example.com":["kazakh"],"publisher@example.com":["publisher"]}
EDITOR_ROLES={}
# Gemini: set TUTOR_PROVIDER=gemini and TUTOR_MODEL to an available Gemini model.
# Keep the key in server secret TUTOR_API_KEY. Gemini ignores TUTOR_BASE_URL.
TUTOR_PROVIDER=compatible

# Vercel only: server-side Turso and Google OAuth configuration.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_SECRET=
AUTH_URL=https://ent-math.vercel.app
